# .gitignore

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Local folder for experimentation.
local

# Ignore per-machine Claude Code state, but keep shared project config
# (.claude/settings.json, agents, commands, skills) tracked.
.claude/settings.local.json
.claude/*.tmp.*